{
  "name": "digital-souls",
  "private": true,
  "devDependencies": {
    "promptfoo": "0.117.2"
  },
  "scripts": {
    "generate:voice-session": "npm --prefix frontend run generate:voice-session",
    "check:voice-session-generated": "npm run generate:voice-session && git diff --exit-code -- backend/app/voice_session/generated.py frontend/src/lib/voice-session/generated.ts",
    "generate:screen-perception": "npm --prefix frontend run generate:screen-perception",
    "check:screen-perception-generated": "npm run generate:screen-perception && git diff --exit-code -- backend/app/screen_perception/generated.py frontend/src/lib/screen-perception/generated.ts",
    "test:unit": "backend/.venv/bin/python -m pytest backend/tests/unit && npm --prefix frontend run test:unit",
    "test:module": "backend/.venv/bin/python -m pytest backend/tests/module && npm --prefix frontend run test:module",
    "test:integration:backend": "backend/.venv/bin/python -m pytest backend/tests/integration",
    "test:integration:inference": "backend/.venv/bin/python -m pytest -s backend/tests/integration/test_inference_real_service_acceptance_integration.py",
    "test:integration:screen-vision": "backend/.venv/bin/python -m pytest -s backend/tests/integration/test_screen_vision_real_service_acceptance_integration.py",
    "test:e2e:mocked": "npm --prefix frontend run test:e2e:mocked",
    "test:integration:text": "npm --prefix frontend run test:integration:text",
    "test:integration:voice": "npm --prefix frontend run test:integration:voice",
    "test:integration:livekit": "PYTHONPATH=backend python3 -m pytest backend/tests/integration/test_livekit_transport_integration.py && npm --prefix frontend run test:integration:livekit",
    "baseline:websocket": "npm --prefix frontend run baseline:websocket",
    "lint:python": "backend/.venv/bin/python -m ruff check --config backend/ruff.toml backend/app",
    "check": "backend/.venv/bin/python -m mypy --config-file backend/mypy.ini backend/app environments && npm --prefix frontend run check",
    "build": "npm --prefix frontend run build",
    "eval:privacy:prompt-lab": "python3 scripts/eval_privacy_conformance.py prompt-lab",
    "eval:privacy:conformance": "python3 scripts/eval_privacy_conformance.py conformance",
    "eval:memory:prompt-lab": "python3 scripts/eval_memory_extraction.py prompt-lab",
    "eval:memory:conformance": "python3 scripts/eval_memory_extraction.py conformance",
    "eval:rag:real": "backend/.venv/bin/python -m pytest backend/tests/integration -m rag_retrieval_real",
    "test:integration:mcp": "backend/.venv/bin/python -m pytest -s backend/tests/integration/test_external_mcp_real_servers_integration.py",
    "test:integration:tool-use": "backend/.venv/bin/python -m pytest -s backend/tests/integration/test_tool_use_real_service_integration.py",
    "test:acceptance:tool-use": "backend/.venv/bin/python scripts/acceptance_tool_use.py",
    "test:acceptance:tool-use-contract": "backend/.venv/bin/python scripts/acceptance_tool_use.py --contract-mcp",
    "eval:screen-reference:conformance": "PYTHONPATH=backend python3 backend/evals/screen_reference/gate.py",
    "test:acceptance:addon-admin": "backend/.venv/bin/python scripts/acceptance_addon_admin.py"
  }
}
