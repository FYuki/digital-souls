      "type": "object",
      "required": [
        "epoch",
        "cursor",
        "position",
        "state"
      ],
      "properties": {
        "epoch": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:~-]{1,256}$"
        },
        "cursor": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:~-]{1,256}$"
        },
        "position": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "state": {
          "type": "object",
          "description": "許可する参照・状態 metadata のみCoreへ投影する。他の項目は保存・配送しない。",
          "properties": {
            "resource_ref": {
              "oneOf": [
                {
                  "type": "string",
                  "maxLength": 256
                },
                {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                {
                  "type": "boolean"
                }
              ]
            },
            "task_ref": {
              "oneOf": [
                {
                  "type": "string",
                  "maxLength": 256
                },
                {
                  "type": "integer",
                  "minimum": -9007199254740991,
