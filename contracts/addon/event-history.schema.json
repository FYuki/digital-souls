                  "type": "string",
                  "maxLength": 256
                },
                {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                {
                  "type": "boolean"
                }
              ]
            },
            "revision": {
