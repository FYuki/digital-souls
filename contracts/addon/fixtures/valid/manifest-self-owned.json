{
  "manifest_version": "1.0",
  "connection": {
    "id": "development-observer",
    "ownership": "self_owned",
    "protocol": "mcp",
    "transport": "streamable_http",
    "endpoint": "http://127.0.0.1:9100/mcp",
    "auth": {"type": "bearer", "secret_ref": "DEVELOPMENT_OBSERVER_MCP_TOKEN"},
    "trust": {"annotations": true, "addon_metadata": true},
    "grant": {"scope": "validated_snapshot", "activation": "next_execution_loop"}
  },
  "capabilities": {
    "source": "static",
    "tools": [
      {
        "name": "state.current",
        "stable_operation_id": "development_observer.state.current",
        "schema_digest": "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        "native_definition": {
          "description": "Return current development state",
          "annotations": {"readOnlyHint": true},
          "_meta": {
            "io.digital-souls/operation": {
              "stable_operation_id": "development_observer.state.current",
              "effect": "read",
              "execution": {"mode": "immediate", "cancellable": false},
              "conflict_scope": null,
              "concurrency": "parallel",
              "idempotency": {"retry_semantics": "status_query"},
              "requires_core_features": []
            }
          }
        }
      }
    ],
    "resources": [],
    "prompts": []
  },
  "core_policy": {
    "enabled": true,
    "sharing": {"mode": "shared"},
    "resource_binding_required": true,
    "execution_budget": {
      "max_calls_per_loop": 6,
      "max_consecutive_same_tool": 3,
      "max_identical_call": 2,
      "normal_max_auto_cycles": 3
    },
    "restrictions": []
  }
}
