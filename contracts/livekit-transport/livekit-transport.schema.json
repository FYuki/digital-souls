{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://digital-souls.local/contracts/livekit-transport/1.0/livekit-transport.schema.json",
  "title": "LiveKitTransportFrame",
  "oneOf": [
    { "$ref": "#/$defs/Ack" },
    { "$ref": "#/$defs/StateSyncRequest" },
    { "$ref": "#/$defs/ControlProbe" },
    { "$ref": "#/$defs/ControlProbeAck" },
    { "$ref": "#/$defs/AuthoritativeState" },
    { "$ref": "#/$defs/LogicalAudioSegment" },
    { "$ref": "#/$defs/ResponseTrackReady" },
    { "$ref": "#/$defs/ResponseAudioFinished" },
    { "$ref": "#/$defs/MicrophoneObservation" },
    { "$ref": "#/$defs/AudioProbeRequest" },
    { "$ref": "#/$defs/AudioProbeReady" },
    { "$ref": "#/$defs/AudioProbeComplete" },
    { "$ref": "#/$defs/AudioProbeFinished" }
  ],
  "$defs": {
    "ProtocolVersion": { "type": "string", "const": "1.0" },
    "Identifier": { "type": "string", "format": "uuid" },
    "Generation": { "type": "integer", "minimum": 0 },
    "TerminalOutcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "session_id", "response_id", "confirmed_audio_sequence"],
      "properties": {
        "type": { "const": "response_interrupted" },
        "session_id": { "$ref": "#/$defs/Identifier" },
        "response_id": { "$ref": "#/$defs/Identifier" },
        "confirmed_audio_sequence": { "type": "integer", "minimum": 0 }
      }
    },
    "Ack": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol_version", "type", "event_id", "generation"],
      "properties": {
        "protocol_version": { "$ref": "#/$defs/ProtocolVersion" },
        "type": { "const": "ack" },
        "event_id": { "$ref": "#/$defs/Identifier" },
        "generation": { "$ref": "#/$defs/Generation" }
      }
    },
    "ControlProbe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol_version",
        "type",
        "probe_id",
        "generation"
      ],
      "properties": {
        "protocol_version": {
          "$ref": "#/$defs/ProtocolVersion"
        },
        "type": {
          "const": "control_probe"
        },
        "probe_id": {
          "$ref": "#/$defs/Identifier"
        },
        "generation": {
          "$ref": "#/$defs/Generation"
        }
      }
    },
    "ControlProbeAck": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol_version",
        "type",
        "probe_id",
        "generation"
      ],
      "properties": {
        "protocol_version": {
          "$ref": "#/$defs/ProtocolVersion"
        },
        "type": {
          "const": "control_probe_ack"
        },
        "probe_id": {
          "$ref": "#/$defs/Identifier"
        },
        "generation": {
          "$ref": "#/$defs/Generation"
        }
      }
    },
    "StateSyncRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol_version", "type", "generation"],
      "properties": {
        "protocol_version": { "$ref": "#/$defs/ProtocolVersion" },
        "type": { "const": "state_sync_request" },
        "generation": { "$ref": "#/$defs/Generation" }
      }
    },
    "AuthoritativeState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol_version", "type", "generation", "session_phase", "terminal_outcomes"],
      "properties": {
        "protocol_version": { "$ref": "#/$defs/ProtocolVersion" },
        "type": { "const": "authoritative_state" },
        "generation": { "$ref": "#/$defs/Generation" },
        "session_phase": { "enum": ["available", "unavailable", "ended"] },
        "terminal_outcomes": { "type": "array", "items": { "$ref": "#/$defs/TerminalOutcome" } }
      }
    },
    "LogicalAudioSegment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol_version", "type", "response_id", "audio_sequence", "generation", "pcm_sample_count"],
      "properties": {
        "protocol_version": { "$ref": "#/$defs/ProtocolVersion" },
        "type": { "const": "logical_audio_segment" },
        "response_id": { "$ref": "#/$defs/Identifier" },
        "audio_sequence": { "type": "integer", "minimum": 0 },
        "generation": { "$ref": "#/$defs/Generation" },
        "pcm_sample_count": { "type": "integer", "minimum": 1 }
      }
    },
    "ResponseTrackReady": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol_version", "type", "response_id", "track_sid", "generation"],
      "properties": {
        "protocol_version": { "$ref": "#/$defs/ProtocolVersion" },
        "type": { "const": "response_track_ready" },
        "response_id": { "$ref": "#/$defs/Identifier" },
        "track_sid": { "type": "string", "pattern": "^TR_[A-Za-z0-9_-]{1,100}$" },
        "generation": { "$ref": "#/$defs/Generation" }
      }
    },
    "ResponseAudioFinished": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol_version", "type", "response_id", "generation", "input_sample_count", "captured_sample_count", "padding_sample_count"],
      "properties": {
        "protocol_version": { "$ref": "#/$defs/ProtocolVersion" },
        "type": { "const": "response_audio_finished" },
        "response_id": { "$ref": "#/$defs/Identifier" },
        "generation": { "$ref": "#/$defs/Generation" },
        "input_sample_count": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "captured_sample_count": { "type": "integer", "minimum": 0, "maximum": 9007199254740991, "multipleOf": 960 },
        "padding_sample_count": { "type": "integer", "minimum": 0, "maximum": 1919 }
      }
    },
    "MicrophoneObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol_version", "type", "generation", "frame_count", "sample_count", "elapsed_ms", "missing_frames"],
      "properties": {
        "protocol_version": { "$ref": "#/$defs/ProtocolVersion" },
        "type": { "const": "microphone_observation" },
        "generation": { "$ref": "#/$defs/Generation" },
        "frame_count": { "type": "integer", "minimum": 1 },
        "sample_count": { "type": "integer", "minimum": 1 },
        "elapsed_ms": { "type": "integer", "minimum": 0 },
        "missing_frames": { "type": "integer", "minimum": 0 }
      }
    }
,
    "AudioProbeRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol_version",
        "type",
        "probe_id",
        "generation"
      ],
      "properties": {
        "protocol_version": {
          "$ref": "#/$defs/ProtocolVersion"
        },
        "type": {
          "const": "audio_probe_request"
        },
        "probe_id": {
          "$ref": "#/$defs/Identifier"
        },
        "generation": {
          "$ref": "#/$defs/Generation"
        }
      }
    },
    "AudioProbeReady": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol_version",
        "type",
        "probe_id",
        "generation",
        "track_sid"
      ],
      "properties": {
        "protocol_version": {
          "$ref": "#/$defs/ProtocolVersion"
        },
        "type": {
          "const": "audio_probe_ready"
        },
        "probe_id": {
          "$ref": "#/$defs/Identifier"
        },
        "generation": {
          "$ref": "#/$defs/Generation"
        },
        "track_sid": {
          "type": "string",
          "pattern": "^TR_[A-Za-z0-9_-]{1,100}$"
        }
      }
    },
    "AudioProbeComplete": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol_version",
        "type",
        "probe_id",
        "generation",
        "track_sid"
      ],
      "properties": {
        "protocol_version": {
          "$ref": "#/$defs/ProtocolVersion"
        },
        "type": {
          "const": "audio_probe_complete"
        },
        "probe_id": {
          "$ref": "#/$defs/Identifier"
        },
        "generation": {
          "$ref": "#/$defs/Generation"
        },
        "track_sid": {
          "type": "string",
          "pattern": "^TR_[A-Za-z0-9_-]{1,100}$"
        }
      }
    },
    "AudioProbeFinished": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol_version",
        "type",
        "probe_id",
        "generation",
        "track_sid",
        "input_sample_count",
        "captured_sample_count",
        "padding_sample_count"
      ],
      "properties": {
        "protocol_version": {
          "$ref": "#/$defs/ProtocolVersion"
        },
        "type": {
          "const": "audio_probe_finished"
        },
        "probe_id": {
          "$ref": "#/$defs/Identifier"
        },
        "generation": {
          "$ref": "#/$defs/Generation"
        },
        "track_sid": {
          "type": "string",
          "pattern": "^TR_[A-Za-z0-9_-]{1,100}$"
        },
        "input_sample_count": {
          "const": 9600
        },
        "captured_sample_count": {
          "const": 10560
        },
        "padding_sample_count": {
          "const": 960
        }
      }
    }
  }
}
