DS_ENVIRONMENT_ID=dev
# SQLite、Chroma、runtime report、cacheを束ねる絶対data root
# devで未指定の場合はbackend/app/data。dogfoodはリポジトリ外を指定する
# DS_DATA_DIR=/var/lib/digital-souls/dogfood
# Ubuntu-dogfoodが所有する共通推論endpoint
OLLAMA_BASE_URL=http://localhost:11434
# 用途ごとのProvider／Model割当て。最初の / より左がProvider ID
INFERENCE_TARGET_CHAT=ollama/gemma4:e4b
INFERENCE_TARGET_CHAT_MAX_INPUT_TOKENS=7168
INFERENCE_TARGET_CHAT_MAX_OUTPUT_TOKENS=1024
INFERENCE_TARGET_PRIVACY=ollama/gemma4:e4b
INFERENCE_TARGET_PRIVACY_MAX_INPUT_TOKENS=7680
INFERENCE_TARGET_PRIVACY_MAX_OUTPUT_TOKENS=512
INFERENCE_TARGET_PRIVACY_OPTIONS_JSON={"temperature":0}
INFERENCE_TARGET_MEMORY_EXTRACTION=ollama/gemma4:e4b
INFERENCE_TARGET_MEMORY_EXTRACTION_MAX_INPUT_TOKENS=7680
INFERENCE_TARGET_MEMORY_EXTRACTION_MAX_OUTPUT_TOKENS=512
INFERENCE_TARGET_MEMORY_EXTRACTION_OPTIONS_JSON={"temperature":0}
INFERENCE_TARGET_MEMORY_CONSOLIDATION=ollama/gemma4:e4b
INFERENCE_TARGET_MEMORY_CONSOLIDATION_MAX_INPUT_TOKENS=7680
INFERENCE_TARGET_MEMORY_CONSOLIDATION_MAX_OUTPUT_TOKENS=512
INFERENCE_TARGET_MEMORY_CONSOLIDATION_OPTIONS_JSON={"temperature":0}
INFERENCE_TARGET_EMBEDDING=ollama/nomic-embed-text:latest
INFERENCE_TARGET_EMBEDDING_MAX_INPUT_TOKENS=8192
# optional Target。利用時だけProvider／Modelと上限を設定する
# INFERENCE_TARGET_HEAVY_REASONING=openai-api/gpt-5.6-sol
# INFERENCE_TARGET_HEAVY_REASONING_MAX_INPUT_TOKENS=24576
# INFERENCE_TARGET_HEAVY_REASONING_MAX_OUTPUT_TOKENS=8192
# openai-api利用時だけBackend専用secretを設定する
# OPENAI_API_KEY=replace-with-backend-only-api-key
# openai-codex利用時は上記API keyではなく専用認証directoryを設定する
# OPENAI_CODEX_HOME=/absolute/path/to/backend-codex-home
# OPENAI_CODEX_EXECUTABLE=/absolute/path/to/codex
# memory formation worker設定（すべて正の整数）
MEMORY_FORMATION_LLM_TIMEOUT_SECONDS=15
MEMORY_FORMATION_MAX_ATTEMPTS=2
# キュー上限。超過時は新しいjobを破棄し、会話応答は継続する
MEMORY_FORMATION_QUEUE_MAXSIZE=100
MEMORY_FORMATION_TOTAL_TIMEOUT_SECONDS=35
MEMORY_FORMATION_MAX_QUEUE_AGE_SECONDS=300
MEMORY_FORMATION_MAX_OUTPUT_TOKENS=512
# idle／夜間persona memory consolidation（すべて正の整数）
MEMORY_CONSOLIDATION_INTERVAL_SECONDS=3600
MEMORY_CONSOLIDATION_IDLE_SECONDS=1800
MEMORY_CONSOLIDATION_BATCH_SIZE=10
MEMORY_CONSOLIDATION_MAX_RUNTIME_SECONDS=300
# faster-whisperモデル。変更時は対応するキャッシュを準備する
WHISPER_MODEL=medium
RAG_ENABLED=true
# Ubuntu-dogfoodが所有する共通推論endpoint。Profileの値と一致させる。
VOICEVOX_BASE_URL=http://127.0.0.1:50021
# shutdown時の新規受付停止からin-flight requestを待つ上限（秒）
VOICEVOX_SHUTDOWN_DRAIN_SECONDS=35
CONVERSATION_TURN_STALE_AFTER_SECONDS=300
CONVERSATION_HISTORY_RETENTION_DAYS=365
# promptへ含めるcompleted会話ターン数（件）。1以上の整数
CONVERSATION_HISTORY_MAX_COMPLETED_TURNS=10
# promptへ含める会話履歴の上限（token）。1以上の整数
CONVERSATION_HISTORY_TOKEN_LIMIT=4096
# 1回のuser入力の上限（token）。1以上の整数
USER_INPUT_TOKEN_LIMIT=8192
# モデル自体の最大context（token）。Targetの入力＋出力上限以上にする
LLM_CONTEXT_TOKEN_LIMIT=32768
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=replace-with-livekit-api-key
LIVEKIT_API_SECRET=replace-with-livekit-api-secret
