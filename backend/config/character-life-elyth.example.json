{
  "version": 1,
  "connections": [
    {
      "manifest_version": "1.0",
      "connection": {
        "id": "elyth",
        "ownership": "external",
        "protocol": "mcp",
        "transport": "streamable_http",
        "endpoint": "https://elythworld.com/api/mcp/remote",
        "auth": {
          "type": "bearer",
          "secret_ref": "ELYTH_API_KEY"
        },
        "trust": {
