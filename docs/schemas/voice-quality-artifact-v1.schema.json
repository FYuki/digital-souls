{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://digital-souls.local/schemas/voice-quality-artifact-v1.schema.json",
  "title": "音声品質集計artifact v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "measurement_kind", "transport", "run_id", "profile",
    "fixture_version", "quantile_method", "clocks", "run_counts", "metrics",
    "stage_outcomes", "whisper", "hardware", "resources", "network"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "measurement_kind": {
      "enum": ["automated_test", "controlled_baseline", "dogfood"]
    },
    "transport": { "enum": ["websocket", "livekit"] },
    "run_id": { "type": "string", "minLength": 1 },
    "profile": { "type": "string", "minLength": 1 },
    "fixture_version": { "type": "string", "minLength": 1 },
    "quantile_method": { "const": "hyndman_fan_type_7" },
    "clocks": { "type": "array", "items": { "$ref": "#/$defs/clock" } },
    "run_counts": { "$ref": "#/$defs/runCounts" },
    "metrics": { "type": "array", "items": { "$ref": "#/$defs/metric" } },
    "stage_outcomes": {
      "type": "array",
      "items": { "$ref": "#/$defs/stageOutcome" }
    },
    "whisper": { "$ref": "#/$defs/whisper" },
    "hardware": { "$ref": "#/$defs/hardware" },
    "resources": { "$ref": "#/$defs/resources" },
    "network": { "$ref": "#/$defs/network" }
  },
  "$defs": {
    "clock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["domain", "method", "unit"],
      "properties": {
        "domain": { "type": "string" },
        "method": { "type": "string" },
        "unit": { "type": "string" }
      }
    },
    "runCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["warmup", "measured", "success", "failure", "excluded"],
      "properties": {
        "warmup": { "type": "integer", "minimum": 0 },
        "measured": { "type": "integer", "minimum": 0 },
        "success": { "type": "integer", "minimum": 0 },
        "failure": { "type": "integer", "minimum": 0 },
        "excluded": { "type": "integer", "minimum": 0 }
      }
    },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name", "status", "unit", "start_point", "end_point", "trial_count",
        "success_count", "failure_count", "missing_count", "not_applicable_count",
        "excluded_count", "rate_denominator", "failure_rate_basis_points", "p50",
        "p95", "not_applicable_reason", "excluded_outcomes"
      ],
      "properties": {
        "name": { "type": "string" },
        "status": {
          "enum": ["measured", "not_applicable", "missing", "failed", "excluded"]
        },
        "unit": { "type": "string" },
        "start_point": { "type": "string" },
        "end_point": { "type": "string" },
        "trial_count": { "type": "integer", "minimum": 0 },
        "success_count": { "type": "integer", "minimum": 0 },
        "failure_count": { "type": "integer", "minimum": 0 },
        "missing_count": { "type": "integer", "minimum": 0 },
        "not_applicable_count": { "type": "integer", "minimum": 0 },
        "excluded_count": { "type": "integer", "minimum": 0 },
        "rate_denominator": { "type": "integer", "minimum": 0 },
        "failure_rate_basis_points": { "type": ["integer", "null"] },
        "p50": { "type": ["number", "null"] },
        "p95": { "type": ["number", "null"] },
        "not_applicable_reason": { "type": ["string", "null"] },
        "missing_outcomes": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0 }
        },
        "excluded_outcomes": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0 }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "not_applicable" } } },
          "then": {
            "properties": {
              "not_applicable_reason": { "type": "string", "minLength": 1 }
            }
          },
          "else": {
            "properties": { "not_applicable_reason": { "type": "null" } }
          }
        }
      ]
    },
    "stageOutcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "stage", "reason_code"],
      "properties": {
        "status": { "enum": ["success", "failed", "excluded"] },
        "stage": { "type": ["string", "null"] },
        "reason_code": { "type": ["string", "null"] }
      }
    },
    "whisper": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "device", "compute_type"],
      "properties": {
        "model": { "type": "string" },
        "device": { "type": "string" },
        "compute_type": { "type": "string" }
      }
    },
    "hardware": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description"],
      "properties": { "description": { "type": "string" } }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "value", "reason"],
      "properties": {
        "status": { "enum": ["measured", "not_applicable", "missing"] },
        "value": { "type": ["number", "null"] },
        "reason": { "type": ["string", "null"] }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cpu_percent", "memory_bytes"],
      "properties": {
        "cpu_percent": { "$ref": "#/$defs/diagnostic" },
        "memory_bytes": { "$ref": "#/$defs/diagnostic" },
        "gpu_utilization_percent": { "$ref": "#/$defs/diagnostic" },
        "gpu_memory_bytes": { "$ref": "#/$defs/diagnostic" },
        "collection": { "anyOf": [{ "$ref": "#/$defs/resource_collection" }, { "type": "null" }] }
      }
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sent_bytes", "received_bytes", "packet_loss_basis_points", "condition"
      ],
      "properties": {
        "sent_bytes": { "$ref": "#/$defs/diagnostic" },
        "received_bytes": { "$ref": "#/$defs/diagnostic" },
        "packet_loss_basis_points": { "$ref": "#/$defs/diagnostic" },
        "condition": { "type": "string" },
        "collection": { "anyOf": [{ "$ref": "#/$defs/network_collection" }, { "type": "null" }] }
      }
    },
    "resource_collection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cpu_scope",
        "cpu_method",
        "memory_method",
        "gpu_scope",
        "gpu_method",
        "backend_samples",
        "cpu_intervals",
        "cpu_observed_ms",
        "maximum_interval_ms",
        "gpu_samples",
        "missing_samples"
      ],
      "properties": {
        "cpu_scope": {
          "const": "owned_backend_container"
        },
        "cpu_method": {
          "const": "cpu_time_delta_over_observer_wall_time_one_core_100_percent"
        },
        "memory_method": {
          "const": "maximum_sampled_container_charged_bytes"
        },
        "gpu_scope": {
          "const": "shared_host_gpu"
        },
        "gpu_method": {
          "const": "maximum_device_utilization_and_maximum_total_used_bytes"
        },
        "backend_samples": {
          "type": "integer",
          "minimum": 0
        },
        "cpu_intervals": {
          "type": "integer",
          "minimum": 0
        },
        "gpu_samples": {
          "type": "integer",
          "minimum": 0
        },
        "cpu_observed_ms": {
          "type": "number",
          "minimum": 0
        },
        "maximum_interval_ms": {
          "type": "number",
          "minimum": 0
        },
        "missing_samples": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "network_collection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "byte_scope",
        "loss_scope",
        "trial_count",
        "sent_trials",
        "received_trials",
        "loss_trials",
        "received_packets",
        "lost_packets",
        "negative_loss_trials",
        "missing_trials"
      ],
      "properties": {
        "byte_scope": {
          "const": "browser_audio_rtp_payload"
        },
        "loss_scope": {
          "const": "browser_downlink_response_tracks"
        },
        "trial_count": {
          "type": "integer",
          "minimum": 0
        },
        "sent_trials": {
          "type": "integer",
          "minimum": 0
        },
        "received_trials": {
          "type": "integer",
          "minimum": 0
        },
        "loss_trials": {
          "type": "integer",
          "minimum": 0
        },
        "received_packets": {
          "type": "integer",
          "minimum": 0
        },
        "lost_packets": {
          "type": "integer",
          "minimum": 0
        },
        "negative_loss_trials": {
          "type": "integer",
          "minimum": 0
        },
        "missing_trials": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  }
}
