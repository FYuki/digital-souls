{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://digital-souls.local/schemas/screen-reference-evaluation-v1.schema.json",
  "title": "画面参照判断のmetadata-only評価artifact v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evidence_kind",
    "generated_at",
    "fixture_contract_version",
    "rule_iterations",
    "metrics",
    "thresholds",
    "passed",
    "cases"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "evidence_kind": { "const": "synthetic_route_conformance" },
    "generated_at": { "type": "string", "format": "date-time" },
    "fixture_contract_version": { "const": "1.0" },
    "rule_iterations": { "type": "integer", "minimum": 1 },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_count",
        "case_pass_rate",
        "false_reference_rate",
        "missed_reference_rate",
        "unnecessary_clarification_rate",
        "judge_call_rate",
        "prohibited_or_unauthorized_inspections",
        "rule_latency_p95_ms"
      ],
      "properties": {
        "case_count": { "type": "integer", "minimum": 1 },
        "case_pass_rate": { "$ref": "#/$defs/rate" },
        "false_reference_rate": { "$ref": "#/$defs/rate" },
        "missed_reference_rate": { "$ref": "#/$defs/rate" },
        "unnecessary_clarification_rate": { "$ref": "#/$defs/rate" },
        "judge_call_rate": { "$ref": "#/$defs/rate" },
        "prohibited_or_unauthorized_inspections": { "type": "integer", "minimum": 0 },
        "rule_latency_p95_ms": { "type": "number", "minimum": 0 }
      }
    },
    "thresholds": {
      "type": "object",
      "additionalProperties": { "type": ["number", "integer"] },
      "minProperties": 7,
      "maxProperties": 7
    },
    "passed": { "type": "boolean" },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id",
          "expected_decision",
          "actual_decision",
          "expected_path",
          "actual_path",
          "passed",
          "rule_latency_ms"
        ],
        "properties": {
          "case_id": { "type": "string", "minLength": 1 },
          "expected_decision": { "$ref": "#/$defs/decision" },
          "actual_decision": { "$ref": "#/$defs/decision" },
          "expected_path": { "$ref": "#/$defs/path" },
          "actual_path": { "$ref": "#/$defs/path" },
          "passed": { "type": "boolean" },
          "rule_latency_ms": { "type": ["number", "null"], "minimum": 0 }
        }
      }
    }
  },
  "$defs": {
    "rate": { "type": "number", "minimum": 0, "maximum": 1 },
    "decision": {
      "type": "string",
      "enum": ["answer_without_screen", "inspect_screen", "clarify_reference"]
    },
    "path": { "type": "string", "enum": ["rule", "llm", "fallback"] }
  }
}
