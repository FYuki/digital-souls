{
  "schemaVersion": 1,
  "name": "integration-irodori",
  "description": "Irodori実接続検証とVOICEVOX比較用。音声選択はCCVで行い、共有TTSの起動・停止は行わない",
  "readyGate": {
    "baseUrl": "http://127.0.0.1:18574"
  },
  "dependencies": {
    "frontend": {
      "mode": "real",
      "source": "managed",
      "baseUrl": "http://localhost:18573",
      "readinessPath": "/"
    },
    "backend": {
      "mode": "real",
      "source": "managed",
      "baseUrl": "http://localhost:18500",
      "readinessPath": "/health/ready",
      "reload": true
    },
    "ollama": {
      "mode": "real",
      "source": "external",
      "baseUrl": "http://localhost:11434",
      "readinessPath": "/api/tags"
    },
    "voicevox": {
      "mode": "real",
      "source": "external",
      "baseUrl": "http://127.0.0.1:50021",
      "readinessPath": "/version"
    },
    "livekit": {
      "mode": "real",
      "source": "external",
      "baseUrl": "http://127.0.0.1:7880",
      "readinessPath": "/"
    },
    "whisper": {
      "mode": "real",
      "source": "external",
      "baseUrl": "http://127.0.0.1:50022",
      "readinessPath": "/health/ready"
    },
    "chroma": {
      "mode": "disabled",
      "source": null
    },
    "irodori": {
      "mode": "real",
      "source": "external",
      "baseUrl": "http://127.0.0.1:50024",
      "readinessPath": "/health/ready"
    }
  }
}
