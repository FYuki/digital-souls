 use std::time::{Duration, SystemTime, UNIX_EPOCH};
 
 /// Maximum number of reconnect attempts before the engine gives up and closes.
-pub const RECONNECT_ATTEMPTS: u32 = 10;
+pub const RECONNECT_ATTEMPTS: u32 = 64;
+
+// 短い通信断では最大500msで再試行し、長い障害には従来の待機を適用する。
+const FAST_RETRY_WINDOW: Duration = Duration::from_secs(10);
+pub(super) const RECONNECT_RETRY_WINDOW: Duration = Duration::from_secs(60);
+const FAST_RETRY_MIN: Duration = Duration::from_millis(250);
+const FAST_RETRY_MAX: Duration = Duration::from_millis(500);
+
+// 新しい試行を開始する時間と回数を制限する。進行中の接続のtimeoutはSDKに従う。
+pub(super) fn retry_delay(attempt: u32, elapsed: Duration) -> Option<Duration> {
+    retry_delay_with_seed(attempt, elapsed, jitter_seed())
+}
+
+fn retry_delay_with_seed(attempt: u32, elapsed: Duration, seed: u64) -> Option<Duration> {
+    if attempt >= RECONNECT_ATTEMPTS || elapsed >= RECONNECT_RETRY_WINDOW {
+        return None;
+    }
+    let millis = if elapsed < FAST_RETRY_WINDOW {
+        let lower = FAST_RETRY_MIN.as_millis() as u64;
+        let upper = FAST_RETRY_MAX.as_millis() as u64;
+        lower + seed % (upper - lower + 1)
+    } else {
+        seed % (nominal(attempt).as_millis() as u64 + 1)
+    };
+    Some(Duration::from_millis(millis).min(RECONNECT_RETRY_WINDOW - elapsed))
+}
+
+fn jitter_seed() -> u64 {
+    SystemTime::now().duration_since(UNIX_EPOCH).map(|d| d.subsec_nanos() as u64).unwrap_or(0)
+}
 
