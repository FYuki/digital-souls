# 共通Irodoriの所有者だけが配置・起動する。dev/testはHTTP利用のみ。
DOGFOOD_IRODORI_IMAGE=digital-souls/irodori:dev
DOGFOOD_IRODORI_VOICES_DIR=/var/lib/digital-souls/irodori/voices
DOGFOOD_IRODORI_MODEL_CACHE=/var/lib/digital-souls/irodori/huggingface
DS_IRODORI_WARMUP_VOICE=miori-b3-4221
# 初期値。最終性能受入では競合なし・同時利用を分けて評価する。
DS_IRODORI_MAX_PENDING=8
DS_IRODORI_QUEUE_TIMEOUT_SECONDS=10
DS_IRODORI_INFERENCE_TIMEOUT_SECONDS=30
DS_IRODORI_STARTUP_TIMEOUT_SECONDS=300
