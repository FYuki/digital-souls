[Unit]
Description=Digital Souls shared Irodori GPU TTS
Requires=docker.service
After=network-online.target docker.service
PartOf=digital-souls-inference.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/digital-souls-irodori
ExecStart=/usr/bin/docker compose --env-file /etc/digital-souls/irodori.env --file compose.yaml up -d --no-build --wait --wait-timeout 600
ExecStop=/usr/bin/docker compose --env-file /etc/digital-souls/irodori.env --file compose.yaml stop
TimeoutStartSec=660
TimeoutStopSec=45

[Install]
WantedBy=digital-souls-inference.target
