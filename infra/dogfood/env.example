# Ubuntu-dogfood専用設定。推論portはenvironments/profiles/dogfood.jsonを参照する。
DS_ENVIRONMENT_ID=dogfood
DOGFOOD_WSL_DISTRO=Ubuntu-dogfood
DOGFOOD_SERVICE_USER=digital-souls
DOGFOOD_SERVICE_GROUP=digital-souls
DOGFOOD_REPOSITORY_URL=https://github.com/example/digital-souls.git
DOGFOOD_REPOSITORY_REVISION=0123456789abcdef0123456789abcdef01234567
DOGFOOD_CLONE_DIR=/opt/digital-souls/current
DOGFOOD_CONFIG_DIR=/etc/digital-souls
DS_DATA_DIR=/var/lib/digital-souls/data
DOGFOOD_STATE_DIR=/var/lib/digital-souls/state
DOGFOOD_LOG_DIR=/var/log/digital-souls
DOGFOOD_VOICEVOX_IMAGE=voicevox/voicevox_engine:cpu-ubuntu20.04-latest
DOGFOOD_VOICEVOX_CONTAINER=digital-souls-voicevox
