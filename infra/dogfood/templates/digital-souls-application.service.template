[Unit]
Description=Digital Souls dogfood application
PartOf=digital-souls-dogfood.target
After=network.target

[Service]
Type=oneshot
User=@DOGFOOD_SERVICE_USER@
Group=@DOGFOOD_SERVICE_GROUP@
EnvironmentFile=@DOGFOOD_CONFIG_DIR@/dogfood.env
Environment="DS_PROFILE=dogfood" "DS_DATA_DIR=@DS_DATA_DIR@" "DS_ENVIRONMENT_RUN_REPORT=@DS_DATA_DIR@/runtime/dogfood/environment-run.json" "DS_PROFILE_REPORT=@DS_DATA_DIR@/runtime/dogfood/resolved-profile.json"
ExecStart=@DOGFOOD_CLONE_DIR@/environments/up.sh
ExecStop=@DOGFOOD_CLONE_DIR@/environments/down.sh
RemainAfterExit=yes
TimeoutStopSec=60s

[Install]
WantedBy=digital-souls-dogfood.target
