[Unit]
Description=Digital Souls dogfood application
PartOf=digital-souls-dogfood.target
After=network.target digital-souls-inference.target

[Service]
Type=oneshot
User=@DOGFOOD_SERVICE_USER@
Group=@DOGFOOD_SERVICE_GROUP@
Environment="DS_ENVIRONMENT_ID=dogfood" "DS_PROFILE=dogfood" "DS_DATA_DIR=@DS_DATA_DIR@" "DS_ENVIRONMENT_RUN_REPORT=@DS_DATA_DIR@/runtime/dogfood/environment-run.json" "DS_PROFILE_REPORT=@DS_DATA_DIR@/runtime/dogfood/resolved-profile.json" "HOME=@DOGFOOD_SERVICE_HOME_DIR@" "XDG_CACHE_HOME=@DS_DATA_DIR@/cache" "npm_config_cache=@DS_DATA_DIR@/cache/npm"
ExecStart=@DOGFOOD_CLONE_DIR@/environments/up.sh
ExecStop=@DOGFOOD_CLONE_DIR@/environments/down.sh
RemainAfterExit=yes
TimeoutStopSec=60s

[Install]
WantedBy=digital-souls-dogfood.target
