DS_ENVIRONMENT_ID=dev
DS_REPOSITORY_ROOT=/workspace/digital-souls
DS_DATA_DIR=/tmp/digital-souls-dev
DS_RUNTIME_UID=1000
DS_RUNTIME_GID=1000
DS_CONTAINER_ENV_FILE=./env.example
